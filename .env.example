APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# --- Business rules (delay severity thresholds, in hours) ---
# 0 < delay <= LOW_MAX  => LOW | LOW_MAX < delay <= MEDIUM_MAX => MEDIUM | delay > MEDIUM_MAX => HIGH
CARGOTRACE_DELAY_LOW_MAX_HOURS=6
CARGOTRACE_DELAY_MEDIUM_MAX_HOURS=24

# --- External APIs (keys live in .env, never in git) ---
EXTERNAL_API_TIMEOUT=5
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
# Nominatim usage policy requires an identifying User-Agent. Put your own contact here.
GEOCODING_USER_AGENT="CargoTrace-UAS/1.0 (your-email@example.com)"

SHOW_DEMO_ACCOUNTS=true

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000

# Midtrans (sandbox). Get keys at https://dashboard.sandbox.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ERP integration: send this key in header X-ERP-KEY to /api/erp/shipments and /api/erp/payments
ERP_API_KEY=cargotrace-erp-demo-key
# Optional: URL that receives a POST when a payment is PAID
ERP_WEBHOOK_URL=
